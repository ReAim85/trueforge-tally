# bridge server auth key (shared between mcp server and bridge)
BRIDGE_API_KEY=your-secret-key-here

# the agent id of your connected desktop agent (check tray app settings)
BRIDGE_AGENT_ID=your-agent-id

# google gemini api key for bill ocr extraction
GEMINI_API_KEY=your-gemini-key

# ports (defaults shown)
BRIDGE_PORT=8080
MCP_PORT=3001
